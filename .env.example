# ===================== FREE SETUP (default) =====================
# 1) Get a free key (no credit card): https://console.groq.com/keys  -> "Create API Key"
# 2) Paste it below, save as .env   (cp .env.example .env)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
# If you hit rate limits, try the smaller model:  LLM_MODEL=llama-3.1-8b-instant

# Embeddings run locally on your PC: free, no key (downloads ~90 MB the first time)
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Other free options for the chat model (replace the 3 LLM_* lines above) ----
# Fully offline with Ollama (install from ollama.com, then:  ollama pull llama3.2):
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_API_KEY=ollama
#   LLM_MODEL=llama3.2
# Google Gemini free tier (key from aistudio.google.com):
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=<a current free Gemini model name from the AI Studio page>
# Paid OpenAI (optional):
#   LLM_BASE_URL=            (empty)
#   LLM_MODEL=gpt-4o-mini
#   EMBEDDING_PROVIDER=openai   (+ OPENAI_API_KEY=sk-... and pip install langchain-openai)

# ===================== RAG tuning =====================
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
# Cosine similarity (0..1). Below this, Ask mode says "I don't have this in your documents".
RELEVANCE_THRESHOLD=0.25
PLAYBOOK_THRESHOLD=0.20

# ===================== Watch mode =====================
WATCH_INTERVAL_SECONDS=60
AUTO_INJECT_EVENTS=false
AUTO_INJECT_INTERVAL_SECONDS=120
